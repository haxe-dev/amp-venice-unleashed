Meta.DisplayName=Battlefield 3 (Venice Unleashed)
Meta.Description=Battlefield 3 dedicated server via the Venice Unleashed (VU) client, run under Wine on Linux
Meta.OS=Windows, Linux
Meta.AarchSupport=NotSupported
Meta.Arch=x86_64
Meta.Author=haxe
Meta.URL=https://veniceunleashed.net
Meta.DisplayImageSource=steam:1238820
Meta.EndpointURIFormat={ip}:{GenericModule.App.Ports.$GamePort}
Meta.ConfigManifest=venice-unleashedconfig.json
Meta.MetaConfigManifest=venice-unleashedmetaconfig.json
Meta.ConfigRoot=venice-unleashed.kvp
Meta.MinAMPVersion=2.6.5.0
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=Venice Unleashed is a Windows application and needs Wine (32-bit prefix). The container ships Wine so nothing has to be installed on the host.
Meta.ExtraSetupStepsURI=https://docs.veniceunleashed.net/hosting/prereq/
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=2
Meta.ReleaseNotes=Fix default MapList.txt line breaks
Meta.BreakingReleaseNotes=
Meta.AppConfigId=a9ecd216-9c70-4e20-b1d5-0343e1edf90f
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
App.DisplayName=Battlefield 3 (Venice Unleashed)
App.RootDir=./venice-unleashed/
App.BaseDirectory=./venice-unleashed/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=client\vu.com
App.ExecutableLinux=/usr/bin/wine
App.WorkingDir=client
App.LinuxCommandLineArgs=vu.com
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} -gamepath "{{$FullBaseDir}}bf3" -serverInstancePath "Z:{{$FullBaseDir}}instance" -server -dedicated -headless -listen 0.0.0.0:{{$GamePort}} -mHarmonyPort {{$HarmonyPort}} -RemoteAdminPort 0.0.0.0:{{$RconPort}} -maxPlayers {{MaxPlayers}} {{TickRate}} {{Unlisted}} {{ExtraArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win32","WINEDEBUG":"-all"}
App.CommandLineParameterFormat=-{0} "{1}"
App.CommandLineParameterDelimiter= 
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.ExitString=
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[venice-unleashedports.json]
App.AdminPortRef=RconPort
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=64
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.TelnetLoginFormat=
App.UpdateSources=@IncludeJson[venice-unleashedupdates.json]
App.PreStartStages=@IncludeJson[venice-unleashedstart.json]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.txt","*.key","*.cfg","*.json","*.lua"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]|\e\[?[?\>\=\da-z]+
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^((WARNING|ERROR): Shader.+|Could not find Wine Gecko.*|.*fixme:.*)$
Console.AppReadyRegex=^.*(Server is now running|Game server started|Successfully authenticated server|Loading level).*$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
App.MonitorDirectChildOnly=False
App.RCONSelectIPMethod=Default
App.TelnetNewLineType=Linux
App.UserActions=[]
Console.PreConnectRegex=
Console.ConnectIPRegex=
Console.HideFromConsoleRegex=
